"put": {
"tags": [
"schedules"
],
"summary": "PUT /v1/schedules/{id} — update any subset of a schedule's fields.",
"description": "Also re-installs the cron job, so a changed `cron_expr`, `action` or\n`enabled` flag takes effect immediately rather than at the next restart.",
"operationId": "update_schedule",
"parameters": [
{
"name": "id",
"in": "path",
"description": "Schedule id (UUID)",
"required": true,
"schema": {
"type": "string"
}
}
],
"requestBody": {
"content": {
"application/json": {
"schema": {
"$ref": "#/components/schemas/UpdateScheduleRequest"
}
}
},
"required": true
},
"responses": {
